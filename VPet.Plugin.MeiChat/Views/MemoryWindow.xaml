<Window x:Class="VPet.Plugin.MeiChat.Views.MemoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧠 芽衣的记忆管理"
        Height="520" Width="560"
        MinHeight="400" MinWidth="460"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style x:Key="TagBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 + 统计 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="🧠 芽衣的记忆" FontSize="20" FontWeight="Bold" Foreground="#333"/>
            <TextBlock x:Name="StatsText" FontSize="12" Foreground="#999" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 搜索栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="6"
                    Background="#FAFAFA" Margin="0,0,8,0" Height="34">
                <Grid>
                    <TextBlock x:Name="SearchPlaceholder" Text="🔍 搜索记忆内容..." FontSize="13" Foreground="#BBB"
                               VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" FontSize="13" Padding="8,0" Height="34"
                             Background="Transparent" BorderThickness="0"
                             TextChanged="SearchBox_TextChanged"/>
                </Grid>
            </Border>
            <Button Grid.Column="1" Content="清空搜索" Width="80" FontSize="12"
                    Background="#E0E0E0" Foreground="#666" Click="BtnClearSearch_Click"/>
        </Grid>

        <!-- 记忆列表 -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8"
                Background="#FAFAFA" Padding="0">
            <Grid>
                <!-- 空状态提示 -->
                <TextBlock x:Name="EmptyHint" Text="📭 还没有任何记忆~" FontSize="16"
                           Foreground="#CCC" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Visible"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="4">
                    <ItemsControl x:Name="MemoryList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#EEE" BorderThickness="0,0,0,1" Padding="8,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 复选框 -->
                                        <CheckBox x:Name="ItemCheck" Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center" Margin="0,0,8,0"/>

                                        <!-- 类型标签 -->
                                        <Border Grid.Column="1"
                                                Background="{Binding TypeColor}"
                                                Style="{StaticResource TagBadge}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TypeLabel}" Foreground="White"
                                                       FontSize="11" FontWeight="SemiBold"/>
                                        </Border>

                                        <!-- 内容 -->
                                        <StackPanel Grid.Column="2" Margin="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                       FontSize="13" Foreground="#444"
                                                       MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding TimeStr}" FontSize="11"
                                                       Foreground="#AAA" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- 单独删除按钮 -->
                                        <Button Grid.Column="3" Content="✕" Width="28" Height="28"
                                                FontSize="12" Background="#F0F0F0" Foreground="#999"
                                                Click="BtnDeleteOne_Click"
                                                Tag="{Binding Index}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 操作按钮栏 -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="🗑️ 删除选中" Width="110"
                    Background="#E74C3C" Foreground="White" FontSize="12"
                    Click="BtnDeleteSelected_Click"/>

            <Button Grid.Column="1" Content="📤 导出备份" Width="100"
                    Background="#27AE60" Foreground="White" FontSize="12"
                    Margin="8,0,0,0"
                    Click="BtnExport_Click"/>

            <Button Grid.Column="3" Content="🔄 刷新" Width="80"
                    Background="#95A5A6" Foreground="White" FontSize="12"
                    Click="BtnRefresh_Click"/>

            <Button Grid.Column="4" Content="🧹 清空全部" Width="100"
                    Background="#E67E22" Foreground="White" FontSize="12"
                    Margin="8,0,0,0"
                    Click="BtnClearAll_Click"/>
        </Grid>

        <!-- 底部状态 -->
        <TextBlock x:Name="StatusText" Grid.Row="4" FontSize="11" Foreground="#AAA"
                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
    </Grid>
</Window>
