<Window x:Class="VPet.Plugin.MeiChat.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="芽衣 · 设置"
        Height="560" Width="520"
        MinHeight="480" MinWidth="420"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">

    <ScrollViewer>
        <StackPanel Margin="20">

            <!-- 标题 -->
            <TextBlock Text="⚙️ 插件设置" FontSize="20" FontWeight="Bold"
                       Foreground="#333" Margin="0,0,0,20"/>

            <!-- ====== API 配置 ====== -->
            <Border Background="#F8F4FF" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🤖 API 配置" FontSize="16" FontWeight="SemiBold"
                               Foreground="#555" Margin="0,0,0,12"/>

                    <!-- API Key -->
                    <TextBlock Text="API Key" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                    <PasswordBox x:Name="ApiKeyBox" Height="36"
                                 PasswordChar="●"
                                 BorderBrush="#DDD" BorderThickness="1"
                                 Padding="8,0"
                                 FontSize="13"/>
                    <TextBlock Text="在 AI 平台官网获取 API Key"
                               FontSize="11" Foreground="#999" Margin="0,4,0,12"/>

                    <!-- API 地址 -->
                    <TextBlock Text="API 地址" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                    <TextBox x:Name="ApiUrlBox" Height="36" FontSize="13"
                             BorderBrush="#DDD" BorderThickness="1"
                             Padding="8,0"/>
                    <TextBlock Text="OpenAI 兼容格式，如 https://api.deepseek.com/v1"
                               FontSize="11" Foreground="#999" Margin="0,4,0,12"/>

                    <!-- 模型选择（下拉预设 + 可输入） -->
                    <TextBlock Text="模型预设" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                    <ComboBox x:Name="ModelPresetBox" Height="36" FontSize="13"
                              BorderBrush="#DDD"
                              SelectionChanged="ModelPresetBox_SelectionChanged">
                        <ComboBoxItem Tag="">自定义（在下方输入）</ComboBoxItem>
                        <ComboBoxItem Tag="deepseek-chat" IsSelected="True">DeepSeek V3（deepseek-chat）</ComboBoxItem>
                        <ComboBoxItem Tag="deepseek-v4-flash">DeepSeek V4 Flash</ComboBoxItem>
                        <ComboBoxItem Tag="deepseek-reasoner">DeepSeek R1（deepseek-reasoner）</ComboBoxItem>
                        <ComboBoxItem Tag="deepseek-v4-flash">DeepSeek V4 Flash</ComboBoxItem>
                        <ComboBoxItem Tag="deepseek-pro">DeepSeek Pro</ComboBoxItem>
                        <ComboBoxItem Tag="gpt-4o">OpenAI GPT-4o</ComboBoxItem>
                        <ComboBoxItem Tag="gpt-4o-mini">OpenAI GPT-4o-mini</ComboBoxItem>
                        <ComboBoxItem Tag="claude-sonnet-4-20250514">Anthropic Claude Sonnet 4.6</ComboBoxItem>
                        <ComboBoxItem Tag="claude-opus-4-20250514">Anthropic Claude Opus 4.8</ComboBoxItem>
                        <ComboBoxItem Tag="gemini-2.0-flash">Google Gemini 2.0 Flash</ComboBoxItem>
                        <ComboBoxItem Tag="qwen-max">阿里 通义千问 Qwen Max</ComboBoxItem>
                        <ComboBoxItem Tag="qwen-plus">阿里 通义千问 Qwen Plus</ComboBoxItem>
                        <ComboBoxItem Tag="glm-4">智谱 GLM-4</ComboBoxItem>
                        <ComboBoxItem Tag="moonshot-v1">月之暗面 Moonshot v1</ComboBoxItem>
                        <ComboBoxItem Tag="ernie-4">百度 文心一言 ERNIE-4</ComboBoxItem>
                        <ComboBoxItem Tag="deepseek-ai/DeepSeek-V3">SiliconFlow DeepSeek V3</ComboBoxItem>
                    </ComboBox>

                    <!-- 自定义模型输入 -->
                    <TextBlock Text="或输入自定义模型名" FontSize="11" Foreground="#999" Margin="0,6,0,2"/>
                    <TextBox x:Name="ModelBox" Height="36" FontSize="13"
                             BorderBrush="#DDD" BorderThickness="1"
                             Padding="8,0"/>

                    <!-- 温度 -->
                    <TextBlock Text="温度 (Temperature)" FontSize="13" Foreground="#666" Margin="0,12,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="TempSlider" Grid.Column="0"
                                Minimum="0" Maximum="1" TickFrequency="0.1"
                                Value="0.7" IsSnapToTickEnabled="True"
                                Margin="0,0,12,0"/>
                        <TextBlock x:Name="TempValue" Grid.Column="1"
                                   Text="0.7" VerticalAlignment="Center"
                                   FontSize="13" Foreground="#666" Width="30"/>
                    </Grid>

                    <!-- Max Tokens -->
                    <TextBlock Text="最大 Token 数" FontSize="13" Foreground="#666" Margin="0,12,0,4"/>
                    <ComboBox x:Name="MaxTokensBox" Height="36" FontSize="13"
                              BorderBrush="#DDD">
                        <ComboBoxItem Tag="2048">2048（简短回复）</ComboBoxItem>
                        <ComboBoxItem Tag="4096" IsSelected="True">4096（默认）</ComboBoxItem>
                        <ComboBoxItem Tag="8192">8192（长回复）</ComboBoxItem>
                        <ComboBoxItem Tag="16384">16384（超长回复）</ComboBoxItem>
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- ====== 桌宠名字 ====== -->
            <Border Background="#FFF0F5" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🎀 桌宠名字" FontSize="16" FontWeight="SemiBold"
                               Foreground="#555" Margin="0,0,0,12"/>
                    <TextBox x:Name="PetNameBox" Height="36" FontSize="13"
                             BorderBrush="#DDD" BorderThickness="1" Padding="8,0"/>
                </StackPanel>
            </Border>

            <!-- ====== 工作目录 ====== -->
            <Border Background="#F0F8FF" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="📁 文件管理" FontSize="16" FontWeight="SemiBold"
                               Foreground="#555" Margin="0,0,0,12"/>

                    <TextBlock Text="工作目录" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="WorkDirBox" Grid.Column="0"
                                 Height="36" FontSize="13"
                                 BorderBrush="#DDD" BorderThickness="1"
                                 Padding="8,0"/>
                        <Button Grid.Column="1" Content="📂 浏览" Width="80"
                                Height="36" Margin="8,0,0,0"
                                FontSize="13" Cursor="Hand"
                                Click="BtnBrowseWorkDir_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ====== 语音朗读 ====== -->
            <Border Background="#F0FFF0" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🔊 语音朗读" FontSize="16" FontWeight="SemiBold"
                               Foreground="#555" Margin="0,0,0,12"/>

                    <CheckBox x:Name="TtsEnabledBox" Content="启用语音朗读"
                              FontSize="13" Foreground="#666" Margin="0,0,0,10"
                              Checked="TtsEnabled_Changed" Unchecked="TtsEnabled_Changed"/>

                    <TextBlock Text="语音提供者" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                    <ComboBox x:Name="TtsProviderBox" Height="34" FontSize="13"
                              BorderBrush="#DDD" SelectionChanged="TtsProvider_Changed">
                        <ComboBoxItem Tag="Edge">Edge TTS（晓晓等在线语音）🌐</ComboBoxItem>
                        <ComboBoxItem Tag="Windows">Windows 内置语音（SAPI）</ComboBoxItem>
                        <ComboBoxItem Tag="Tongyi">通义千问语音</ComboBoxItem>
                        <ComboBoxItem Tag="CustomHTTP">自定义 HTTP（第三方模型）🔌</ComboBoxItem>
                    </ComboBox>

                    <TextBlock x:Name="VoiceLabel" Text="选择语音" FontSize="13" Foreground="#666" Margin="0,10,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="VoiceSelectBox" Grid.Column="0" Height="34" FontSize="13"
                                  BorderBrush="#DDD"/>
                        <Button Grid.Column="1" x:Name="BtnPreview" Content="▶ 试听" Width="70"
                                Height="34" FontSize="12" Margin="8,0,0,0"
                                Background="#E8F5E9" Foreground="#2E7D32"
                                BorderThickness="1" BorderBrush="#A5D6A7"
                                Cursor="Hand" Click="BtnPreview_Click"/>
                    </Grid>

                    <TextBlock Text="语速" FontSize="13" Foreground="#666" Margin="0,10,0,4"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="TtsRateSlider" Grid.Column="0"
                                Minimum="-10" Maximum="10" TickFrequency="1"
                                Value="0" IsSnapToTickEnabled="True"
                                Margin="0,0,12,0"/>
                        <TextBlock x:Name="TtsRateValue" Grid.Column="1"
                                   Text="0" VerticalAlignment="Center"
                                   FontSize="13" Foreground="#666" Width="30"/>
                    </Grid>

                    <!-- 通义千问配置（默认隐藏） -->
                    <StackPanel x:Name="TongyiPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="通义千问 API Key" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                        <PasswordBox x:Name="TongyiKeyBox" Height="36" FontSize="13"
                                     PasswordChar="●" BorderBrush="#DDD" Padding="8,0"/>
                        <TextBlock Text="语音模型（如 sambert-zhichu-v1）" FontSize="13" Foreground="#666" Margin="0,8,0,4"/>
                        <TextBox x:Name="TongyiVoiceBox" Height="34" FontSize="13"
                                 BorderBrush="#DDD" Padding="8,0"/>
                    </StackPanel>

                    <!-- 自定义 HTTP 配置（默认隐藏） -->
                    <StackPanel x:Name="CustomHttpPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock Text="提供者名称" FontSize="13" Foreground="#666" Margin="0,0,0,4"/>
                        <TextBox x:Name="CustomNameBox" Height="34" FontSize="13"
                                 BorderBrush="#DDD" Padding="8,0"/>
                        <TextBlock Text="HTTP 端点 URL" FontSize="13" Foreground="#666" Margin="0,8,0,4"/>
                        <TextBox x:Name="CustomUrlBox" Height="34" FontSize="13"
                                 BorderBrush="#DDD" Padding="8,0"/>
                        <TextBlock Text="请求模板（{text} 为文本占位符）" FontSize="13" Foreground="#666" Margin="0,8,0,4"/>
                        <TextBox x:Name="CustomTemplateBox" Height="34" FontSize="13"
                                 BorderBrush="#DDD" Padding="8,0"/>
                        <CheckBox x:Name="CustomRawAudioBox" Content="响应为纯音频流" FontSize="13"
                                  Foreground="#666" Margin="0,8,0,0" IsChecked="True"/>
                        <TextBox x:Name="CustomAudioFieldBox" Height="34" FontSize="13"
                                 BorderBrush="#DDD" Padding="8,0" Margin="0,4,0,0"
                                 Text="data.audio"/>
                        <TextBlock Text="JSON中音频字段路径（纯音频流模式不填）" FontSize="11" Foreground="#999"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ====== 快捷回复 ====== -->
            <Border Background="#FFF8F0" CornerRadius="12" Padding="16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="🎭 角色设定" FontSize="16" FontWeight="SemiBold"
                               Foreground="#555" Margin="0,0,0,12"/>

                    <TextBlock Text="系统提示词（System Prompt）" FontSize="13"
                               Foreground="#666" Margin="0,0,0,4"/>
                    <TextBox x:Name="SystemPromptBox"
                             Height="100" FontSize="13"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             BorderBrush="#DDD" BorderThickness="1"
                             Padding="8"
                             VerticalScrollBarVisibility="Auto"/>

                    <Button Content="恢复默认提示词" Margin="0,8,0,0"
                            Height="28" FontSize="12" Cursor="Hand"
                            Background="#F0F0F0" BorderThickness="1"
                            BorderBrush="#DDD"
                            Click="BtnResetPrompt_Click"/>
                </StackPanel>
            </Border>

            <!-- ====== 按钮区 ====== -->
            <Grid Margin="0,8,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1" Width="120" Height="36"
                        Margin="0,0,8,0"
                        Background="#E8F5E9"
                        BorderBrush="#A5D6A7" BorderThickness="1"
                        CornerRadius="6">
                    <Button Content="测试 API 连接"
                            FontSize="13" Cursor="Hand"
                            Background="Transparent" BorderThickness="0"
                            Click="BtnTestApi_Click"/>
                </Border>

                <Border Grid.Column="2" Width="120" Height="36"
                        Background="#4A90D9"
                        CornerRadius="6">
                    <Button Content="✅ 保存设置"
                            FontSize="14" FontWeight="SemiBold"
                            Cursor="Hand"
                            Foreground="White"
                            Background="Transparent" BorderThickness="0"
                            Click="BtnSave_Click"/>
                </Border>
            </Grid>

            <!-- 测试状态 -->
            <TextBlock x:Name="TestStatus" Text="" FontSize="12"
                       Foreground="#666" HorizontalAlignment="Center"
                       Margin="0,0,0,10"/>

        </StackPanel>
    </ScrollViewer>
</Window>
