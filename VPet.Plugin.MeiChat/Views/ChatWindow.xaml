<Window x:Class="VPet.Plugin.MeiChat.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🌸 与芽衣对话"
        Height="450" Width="360"
        WindowStyle="ToolWindow"
        ResizeMode="CanResize"
        Topmost="False"
        ShowInTaskbar="True">

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 消息列表 -->
        <ScrollViewer x:Name="MessageArea" Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      Background="#F5F5F5"
                      Padding="8">
            <StackPanel x:Name="MessageList"/>
        </ScrollViewer>

        <!-- 输入区 -->
        <Border Grid.Row="1" Background="White" Padding="8,6"
                BorderBrush="#E0E0E0" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="InputBox" Grid.Column="0"
                         Height="32" FontSize="13"
                         Padding="8,4"
                         BorderBrush="#CCC" BorderThickness="1"
                         KeyDown="InputBox_KeyDown"/>
                <Button x:Name="BtnSend" Grid.Column="1"
                        Content="发送" Width="56" Height="32"
                        Margin="6,0,0,0" FontSize="13"
                        Background="#4A90D9" Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="BtnSend_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
