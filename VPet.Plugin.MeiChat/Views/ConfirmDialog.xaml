<Window x:Class="VPet.Plugin.MeiChat.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="520"
        MinWidth="400" MaxWidth="700"
        MinHeight="200" MaxHeight="500"
        ShowInTaskbar="False"
        Topmost="False">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="6,0"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TitleIcon" FontSize="28" Margin="0,0,0,4"/>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- 命令内容（可滚动、可拖动调整大小） -->
        <Border Grid.Row="1"
                Background="#F5F5F5"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,14">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          MaxHeight="280">
                <TextBlock x:Name="CommandText"
                           FontFamily="Consolas"
                           FontSize="13"
                           TextWrapping="Wrap"
                           Foreground="#333"/>
            </ScrollViewer>
        </Border>

        <!-- 按钮 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左下: 自动模式按钮 -->
            <Button x:Name="BtnAllowAuto" Grid.Column="0"
                    Background="#27AE60"
                    Foreground="White"
                    Content="🚀 允许并不再询问"
                    FontSize="13"
                    Click="BtnAllowAuto_Click"/>

            <!-- 右下: 拒绝 / 允许 -->
            <Button x:Name="BtnReject" Grid.Column="2"
                    Background="#95A5A6"
                    Foreground="White"
                    Content="拒绝"
                    Click="BtnReject_Click"/>
            <Button x:Name="BtnAllow" Grid.Column="3"
                    Background="#4A90D9"
                    Foreground="White"
                    Content="允许执行"
                    Click="BtnAllow_Click"/>
        </Grid>
    </Grid>
</Window>
