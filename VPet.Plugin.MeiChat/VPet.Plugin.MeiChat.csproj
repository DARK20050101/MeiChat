    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>VPet.Plugin.MeiChat</RootNamespace>
    <AssemblyName>VPet.Plugin.MeiChat</AssemblyName>
    <Version>2.0.0</Version>
    <Description>芽衣 Claude AI 助手 - VPet 插件</Description>
